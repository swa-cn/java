const __vite__css = "/* =====================================================================\n * Q版可爱风 登录/注册  —— Vue 3 改造版全局样式\n * 糖果配色 · 云朵星星 · 猫咪吉祥物（会捂眼睛）· 果冻按钮 · 彩带庆祝\n *\n * 安全说明（务必阅读）：\n *  - 本页为纯前端演示，数据保存在浏览器 localStorage，仅用于展示交互与 UI。\n *  - 密码使用「每用户随机盐 + SHA-256」做哈希后存储，绝不保存明文。\n *  - 真实生产环境必须使用后端：HTTPS 传输、服务端加盐哈希（bcrypt/argon2）、\n *    速率限制、验证码、防暴力破解、JWT/Cookie 会话等。前端哈希不能替代服务端校验。\n *  - 所有用户输入均通过 textContent / 属性赋值输出，避免 XSS。\n * ===================================================================== */\n\n:root {\n  --bg-1: #8ec9ff;\n  --bg-2: #ffc7e0;\n  --bg-3: #d3bfff;\n  --card: #ffffff;\n  --ink: #4a3b52;\n  --ink-soft: #8d7f99;\n  --ink-dim: #b8adc2;\n  --line: #ffd9e8;\n  --pink: #ff7eb3;\n  --pink-deep: #ff5c9d;\n  --candy: #7c6cff;\n  --candy-2: #9b8cff;\n  --mint: #5fd4b0;\n  --sun: #ffcf5c;\n  --ok: #2fb982;\n  --bad: #ff6b81;\n  --radius: 30px;\n  --shadow: 0 22px 55px -18px rgba(124, 78, 140, 0.45);\n  --font-round: \"Yuanti SC\", \"YouYuan\", \"幼圆\", \"Microsoft YaHei\", \"PingFang SC\",\n                -apple-system, \"Segoe UI\", sans-serif;\n}\n\n* { box-sizing: border-box; }\nhtml, body { margin: 0; min-height: 100%; }\n\nbody {\n  font-family: var(--font-round);\n  color: var(--ink);\n  background:\n    radial-gradient(60% 50% at 85% 10%, rgba(255, 207, 92, 0.35) 0%, transparent 60%),\n    radial-gradient(70% 60% at 10% 90%, rgba(124, 108, 255, 0.28) 0%, transparent 60%),\n    linear-gradient(150deg, var(--bg-1) 0%, var(--bg-2) 52%, var(--bg-3) 100%);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  padding: 60px 16px 48px;\n  overflow-x: hidden;\n  -webkit-font-smoothing: antialiased;\n}\n\n#fx {\n  position: fixed;\n  inset: 0;\n  width: 100%;\n  height: 100%;\n  pointer-events: none;\n  z-index: 30;\n}\n\n/* ---------- 背景装饰 ---------- */\n.scene { position: fixed; inset: 0; pointer-events: none; z-index: 0; overflow: hidden; }\n\n.cloud { position: absolute; opacity: 0.9; }\n.cloud i {\n  position: absolute;\n  background: #fff;\n  border-radius: 50%;\n}\n.cloud.c1 { top: 12%; left: 6%;  width: 150px; height: 52px; animation: drift 34s linear infinite; }\n.cloud.c2 { top: 24%; right: 8%; width: 110px; height: 40px; opacity: 0.75; animation: drift 44s linear infinite -12s; }\n.cloud.c3 { bottom: 16%; left: 12%; width: 90px; height: 34px; opacity: 0.6; animation: drift 52s linear infinite -26s; }\n.cloud i:nth-child(1) { width: 52%; height: 160%; left: 4%;  bottom: -6%; }\n.cloud i:nth-child(2) { width: 40%; height: 120%; left: 42%; bottom: -6%; }\n.cloud i:nth-child(3) { width: 34%; height: 200%; left: 24%; bottom: 20%; }\n@keyframes drift {\n  from { transform: translateX(-16vw); }\n  to   { transform: translateX(112vw); }\n}\n\n.star {\n  position: absolute;\n  width: 14px; height: 14px;\n  background: #fff;\n  clip-path: polygon(50% 0%, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%);\n  animation: twinkle 2.6s ease-in-out infinite;\n  filter: drop-shadow(0 0 6px rgba(255,255,255,.9));\n}\n.star.s1 { top: 16%; right: 22%; }\n.star.s2 { top: 34%; left: 16%; width: 10px; height: 10px; animation-delay: -0.9s; }\n.star.s3 { top: 8%;  left: 42%; width: 12px; height: 12px; animation-delay: -1.6s; }\n.star.s4 { bottom: 26%; right: 14%; animation-delay: -0.5s; }\n.star.s5 { bottom: 12%; left: 30%; width: 9px; height: 9px; animation-delay: -2.1s; }\n@keyframes twinkle {\n  0%, 100% { transform: scale(0.7) rotate(0deg); opacity: 0.45; }\n  50%      { transform: scale(1.15) rotate(18deg); opacity: 1; }\n}\n\n.heart {\n  position: absolute;\n  color: #ff9ec4;\n  text-shadow: 0 4px 14px rgba(255, 126, 179, 0.45);\n  animation: floaty 7s ease-in-out infinite;\n}\n.heart.h1 { top: 42%; right: 10%; font-size: 26px; }\n.heart.h2 { top: 64%; left: 8%;  font-size: 18px; animation-delay: -2.4s; }\n.heart.h3 { top: 22%; left: 30%; font-size: 15px; animation-delay: -4.8s; }\n@keyframes floaty {\n  0%, 100% { transform: translateY(0) rotate(-6deg); }\n  50%      { transform: translateY(-16px) rotate(8deg); }\n}\n\n/* ---------- 卡片 ---------- */\n.auth-shell {\n  position: relative;\n  z-index: 2;\n  width: 100%;\n  max-width: 440px;\n}\n.auth-card {\n  position: relative;\n  background: var(--card);\n  border: 4px solid #fff;\n  border-radius: var(--radius);\n  box-shadow: var(--shadow);\n  padding: 64px 32px 26px;\n  animation: pop 0.55s cubic-bezier(.34,1.56,.64,1) both;\n}\n@keyframes pop {\n  from { opacity: 0; transform: translateY(18px) scale(0.94); }\n  to   { opacity: 1; transform: translateY(0) scale(1); }\n}\n.auth-card.celebrate { animation: jelly 0.7s cubic-bezier(.34,1.56,.64,1); }\n@keyframes jelly {\n  0%   { transform: scale(1, 1); }\n  30%  { transform: scale(1.04, 0.94); }\n  50%  { transform: scale(0.97, 1.03); }\n  75%  { transform: scale(1.02, 0.98); }\n  100% { transform: scale(1, 1); }\n}\n/* 卡片顶部糖果条 */\n.auth-card::before {\n  content: \"\";\n  position: absolute;\n  top: 0; left: 24px; right: 24px;\n  height: 10px;\n  border-radius: 0 0 10px 10px;\n  background: repeating-linear-gradient(135deg,\n    var(--pink) 0 14px, var(--sun) 14px 28px, var(--mint) 28px 42px, var(--candy) 42px 56px);\n  opacity: 0.9;\n}\n\n/* ---------- 吉祥物 ---------- */\n.mascot {\n  position: absolute;\n  top: -52px;\n  left: 50%;\n  width: 104px;\n  height: 98px;\n  margin-left: -52px;\n  filter: drop-shadow(0 8px 14px rgba(124, 78, 140, 0.3));\n  animation: bob 3.2s ease-in-out infinite;\n}\n@keyframes bob {\n  0%, 100% { transform: translateY(0); }\n  50%      { transform: translateY(-6px); }\n}\n.mascot svg { width: 100%; height: 100%; }\n.mascot .eyes {\n  transform-box: fill-box;\n  transform-origin: center;\n  animation: blink 4.6s infinite;\n}\n@keyframes blink {\n  0%, 92%, 100% { transform: scaleY(1); }\n  95%, 97%      { transform: scaleY(0.06); }\n}\n.mascot .paws {\n  opacity: 0;\n  transform: translateY(16px);\n  transition: opacity 0.18s ease, transform 0.22s cubic-bezier(.34,1.56,.64,1);\n}\n.mascot.covering .paws { opacity: 1; transform: translateY(0); }\n.mascot.covering { animation: none; }\n\n/* ---------- 品牌 ---------- */\n.brand { text-align: center; margin-bottom: 18px; }\n.brand-name {\n  margin: 0;\n  font-size: 26px;\n  font-weight: 800;\n  letter-spacing: 1px;\n  color: var(--ink);\n}\n.tilde {\n  color: var(--pink);\n  display: inline-block;\n  animation: wiggle 1.6s ease-in-out infinite;\n  transform-origin: bottom left;\n}\n@keyframes wiggle {\n  0%, 100% { transform: rotate(0deg); }\n  40%      { transform: rotate(14deg) translateY(-2px); }\n}\n.brand-sub { margin: 7px 0 0; font-size: 13.5px; color: var(--ink-soft); }\n\n/* ---------- 表单 ---------- */\n.form { display: flex; flex-direction: column; gap: 14px; }\n.field { display: flex; flex-direction: column; gap: 6px; }\n.field label {\n  font-size: 12.5px;\n  font-weight: 800;\n  color: var(--ink-soft);\n  letter-spacing: 0.5px;\n}\n.field input {\n  width: 100%;\n  padding: 12px 14px;\n  font-size: 14px;\n  font-family: inherit;\n  color: var(--ink);\n  background: #fdf6fb;\n  border: 2px solid var(--line);\n  border-radius: 16px;\n  transition: border-color 0.2s ease, box-shadow 0.2s ease, background 0.2s ease, transform 0.2s ease;\n}\n.field input::placeholder { color: #c9bccf; }\n.field input:focus {\n  outline: none;\n  background: #fff;\n  border-color: var(--pink);\n  box-shadow: 0 0 0 4px rgba(255, 126, 179, 0.18);\n  transform: translateY(-1px);\n}\n.field.invalid input {\n  border-color: var(--bad);\n  box-shadow: 0 0 0 4px rgba(255, 107, 129, 0.15);\n  animation: shake 0.35s ease;\n}\n@keyframes shake {\n  0%, 100% { transform: translateX(0); }\n  30%      { transform: translateX(-4px); }\n  60%      { transform: translateX(4px); }\n}\n.error { font-size: 12px; color: var(--bad); line-height: 1.35; }\n\n/* 密码框 */\n.input-wrap { position: relative; display: flex; align-items: center; }\n.input-wrap input { padding-right: 62px; }\n.toggle-pw {\n  position: absolute;\n  right: 9px;\n  border: 0;\n  background: #ffeef5;\n  color: var(--pink-deep);\n  font-size: 12px;\n  font-weight: 800;\n  cursor: pointer;\n  padding: 6px 10px;\n  border-radius: 999px;\n  font-family: inherit;\n  transition: background 0.18s ease, transform 0.12s ease;\n}\n.toggle-pw:hover { background: #ffdfe9; }\n.toggle-pw:active { transform: scale(0.92); }\n\n/* 密码强度 */\n.strength { display: flex; align-items: center; gap: 10px; margin-top: 2px; }\n.strength-bar { display: flex; gap: 5px; flex: 1; }\n.strength-bar i {\n  height: 6px; flex: 1;\n  border-radius: 999px;\n  background: #f3e6f2;\n  transition: background 0.25s ease;\n}\n.strength.s1 .strength-bar i:nth-child(-n+1) { background: #ff8a9e; }\n.strength.s2 .strength-bar i:nth-child(-n+2) { background: var(--sun); }\n.strength.s3 .strength-bar i:nth-child(-n+3) { background: #8fd3ff; }\n.strength.s4 .strength-bar i:nth-child(-n+4) { background: var(--mint); }\n.strength-label { font-size: 11.5px; color: var(--ink-dim); white-space: nowrap; }\n\n/* 记住我 */\n.checkbox {\n  display: flex;\n  align-items: center;\n  gap: 9px;\n  font-size: 13px;\n  color: var(--ink-soft);\n  cursor: pointer;\n  user-select: none;\n}\n.checkbox input { width: 17px; height: 17px; accent-color: var(--pink); cursor: pointer; }\n\n/* ---------- 按钮 ---------- */\n.btn-primary {\n  margin-top: 4px;\n  border: 0;\n  border-radius: 999px;\n  padding: 14px 16px;\n  font-family: inherit;\n  font-size: 16px;\n  font-weight: 800;\n  letter-spacing: 6px;\n  text-indent: 6px;\n  color: #fff;\n  background: linear-gradient(135deg, var(--pink) 0%, var(--pink-deep) 55%, #ff8a5c 130%);\n  cursor: pointer;\n  box-shadow: 0 12px 24px -8px rgba(255, 92, 157, 0.6), inset 0 -3px 0 rgba(0,0,0,0.08);\n  transition: transform 0.16s cubic-bezier(.34,1.56,.64,1), box-shadow 0.2s ease, filter 0.2s ease;\n}\n.btn-primary:hover {\n  transform: translateY(-2px) scale(1.015);\n  box-shadow: 0 16px 30px -8px rgba(255, 92, 157, 0.7);\n  filter: brightness(1.04);\n}\n.btn-primary:active { transform: scale(0.97); }\n.btn-primary:disabled { opacity: 0.6; cursor: not-allowed; transform: none; }\n\n.btn-ghost {\n  margin-top: 6px;\n  width: 100%;\n  border: 2px solid var(--line);\n  border-radius: 999px;\n  padding: 12px 16px;\n  font-family: inherit;\n  font-size: 15px;\n  font-weight: 800;\n  color: var(--pink-deep);\n  background: #fff;\n  cursor: pointer;\n  transition: background 0.2s ease, border-color 0.2s ease, transform 0.15s ease;\n}\n.btn-ghost:hover { background: #fff5f9; border-color: var(--pink); transform: translateY(-1px); }\n\n.form-msg { margin: 2px 0 0; min-height: 17px; font-size: 13px; text-align: center; font-weight: 700; }\n.form-msg.ok  { color: var(--ok); }\n.form-msg.bad { color: var(--bad); }\n\n.legal {\n  margin: 16px 0 0;\n  font-size: 11.5px;\n  text-align: center;\n  color: var(--ink-dim);\n}\n.legal a { color: var(--pink-deep); font-weight: 700; text-decoration: none; }\n\n/* ---------- 登录后面板 ---------- */\n.dashboard { text-align: center; padding-top: 56px; }\n.avatar {\n  width: 72px; height: 72px;\n  margin: -8px auto 12px;\n  display: grid; place-items: center;\n  border-radius: 50%;\n  font-size: 26px;\n  font-weight: 800;\n  color: #fff;\n  background: linear-gradient(135deg, var(--pink) 0%, var(--candy) 100%);\n  border: 4px solid #fff;\n  box-shadow: 0 10px 24px -8px rgba(124, 108, 255, 0.55);\n}\n.dash-title { margin: 0; font-size: 24px; font-weight: 800; }\n.dash-sub { margin: 8px 0 0; font-size: 13.5px; color: var(--ink-soft); word-break: break-all; }\n.dash-info {\n  margin: 20px 0;\n  display: grid;\n  gap: 11px;\n  text-align: left;\n  background: #fdf6fb;\n  border: 2px dashed var(--line);\n  border-radius: 18px;\n  padding: 15px 18px;\n}\n.dash-info div { display: flex; justify-content: space-between; gap: 12px; }\n.dash-info dt { color: var(--ink-dim); font-size: 13px; font-weight: 700; }\n.dash-info dd { margin: 0; font-size: 13px; font-weight: 800; word-break: break-all; text-align: right; }\n\n.is-hidden { display: none !important; }\n\n/* =====================================================================\n * 独立注册页（RegisterPage.vue）—— 全屏左右分栏\n * 与登录卡片同一套糖果配色 / 圆体字 / 果冻动效\n * ===================================================================== */\n.auth-shell.is-wide { max-width: 1000px; }\n\n.reg-card {\n  position: relative;\n  display: grid;\n  grid-template-columns: 372px 1fr;\n  background: var(--card);\n  border: 4px solid #fff;\n  border-radius: var(--radius);\n  box-shadow: var(--shadow);\n  overflow: hidden;\n  animation: pop 0.55s cubic-bezier(.34, 1.56, .64, 1) both;\n}\n.reg-card.celebrate { animation: jelly 0.7s cubic-bezier(.34, 1.56, .64, 1); }\n\n/* ---------- 左侧品牌面板 ---------- */\n.reg-brand {\n  position: relative;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  padding: 40px 28px 32px;\n  text-align: center;\n  color: #fff;\n  background:\n    radial-gradient(120% 80% at 18% 0%, rgba(255, 207, 92, 0.55) 0%, transparent 58%),\n    radial-gradient(110% 70% at 92% 100%, rgba(95, 212, 176, 0.45) 0%, transparent 62%),\n    linear-gradient(165deg, #ff93c4 0%, #ff6fa8 40%, #8b7bff 100%);\n}\n.reg-brand::after {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  background-image: radial-gradient(rgba(255, 255, 255, 0.55) 1.5px, transparent 1.6px);\n  background-size: 26px 26px;\n  opacity: 0.35;\n  pointer-events: none;\n}\n\n.reg-mascot {\n  position: static;\n  width: 118px;\n  height: 112px;\n  margin: 0 auto 12px;\n  animation: bob 3.2s ease-in-out infinite;\n}\n\n.reg-brand-title {\n  position: relative;\n  z-index: 1;\n  margin: 0;\n  font-size: 27px;\n  font-weight: 800;\n  letter-spacing: 1px;\n  color: #fff;\n  text-shadow: 0 3px 10px rgba(120, 40, 90, 0.28);\n}\n.reg-brand .tilde { color: var(--sun); }\n.reg-brand-sub {\n  position: relative;\n  z-index: 1;\n  margin: 8px 0 0;\n  font-size: 13px;\n  color: rgba(255, 255, 255, 0.92);\n}\n\n.reg-perks {\n  position: relative;\n  z-index: 1;\n  list-style: none;\n  width: 100%;\n  margin: 22px 0 0;\n  padding: 0;\n  display: flex;\n  flex-direction: column;\n  gap: 11px;\n  text-align: left;\n}\n.reg-perks li {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  padding: 10px 12px;\n  font-size: 12.5px;\n  font-weight: 700;\n  color: #fff;\n  background: rgba(255, 255, 255, 0.18);\n  border: 1.5px solid rgba(255, 255, 255, 0.38);\n  border-radius: 14px;\n  backdrop-filter: blur(4px);\n}\n.perk-dot {\n  flex: 0 0 auto;\n  width: 22px;\n  height: 22px;\n  display: grid;\n  place-items: center;\n  border-radius: 50%;\n  font-size: 12px;\n  font-weight: 800;\n  background: #fff;\n  box-shadow: 0 4px 10px -3px rgba(90, 30, 70, 0.35);\n}\n.perk-dot.d1 { color: var(--pink-deep); }\n.perk-dot.d2 { color: var(--candy); }\n.perk-dot.d3 { color: var(--ok); }\n\n.reg-brand-foot {\n  position: relative;\n  z-index: 1;\n  margin: 22px 0 0;\n  font-size: 12.5px;\n  color: rgba(255, 255, 255, 0.92);\n}\n.reg-brand-foot .link-btn {\n  color: #fff;\n  border-bottom-color: rgba(255, 255, 255, 0.65);\n}\n.reg-brand-foot .link-btn:hover { color: var(--sun); border-bottom-color: var(--sun); }\n\n/* ---------- 右侧表单面板 ---------- */\n.reg-panel {\n  position: relative;\n  padding: 44px 38px 30px;\n}\n.reg-panel::before {\n  content: \"\";\n  position: absolute;\n  top: 0;\n  left: 32px;\n  right: 32px;\n  height: 8px;\n  border-radius: 0 0 10px 10px;\n  background: repeating-linear-gradient(135deg,\n    var(--pink) 0 14px, var(--sun) 14px 28px, var(--mint) 28px 42px, var(--candy) 42px 56px);\n  opacity: 0.9;\n}\n\n.reg-head { margin-bottom: 20px; }\n.reg-head h2 { margin: 0; font-size: 23px; font-weight: 800; letter-spacing: 0.5px; }\n.reg-head p { margin: 7px 0 0; font-size: 12.5px; color: var(--ink-soft); }\n.reg-head i,\n.reg-form .field label i {\n  color: var(--bad);\n  font-style: normal;\n}\n\n.reg-form { display: flex; flex-direction: column; gap: 15px; }\n\n/* 输入框右侧状态角标 */\n.input-wrap.has-flag input { padding-right: 48px; }\n\n/* 图形验证码：输入框 + 图片并排，点图片换一张 */\n.captcha-row {\n  display: flex;\n  gap: 10px;\n  align-items: stretch;\n}\n.captcha-row input {\n  flex: 1;\n  min-width: 0;\n  letter-spacing: 2px;\n  font-size: 15px;\n}\n.captcha-img-btn {\n  flex: none;\n  width: 116px;\n  height: 40px;\n  padding: 0;\n  border: 0;\n  border-radius: 12px;\n  overflow: hidden;\n  cursor: pointer;\n  background: #f3ecff;\n  box-shadow: inset 0 0 0 1.5px rgba(124, 108, 255, 0.35);\n  transition: transform 0.12s ease, box-shadow 0.18s ease;\n}\n.captcha-img-btn:hover:not(:disabled) {\n  box-shadow: inset 0 0 0 1.5px rgba(124, 108, 255, 0.7), 0 6px 14px -8px rgba(124, 108, 255, 0.8);\n}\n.captcha-img-btn:active:not(:disabled) { transform: scale(0.97); }\n.captcha-img-btn:disabled { cursor: wait; opacity: 0.75; }\n.captcha-img {\n  display: block;\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n  user-select: none;\n  pointer-events: none;\n}\n.captcha-loading {\n  display: grid;\n  place-items: center;\n  width: 100%;\n  height: 100%;\n  font-size: 12px;\n  color: #8e7cc3;\n}\n.field-flag {\n  position: absolute;\n  right: 15px;\n  width: 20px;\n  height: 20px;\n  display: grid;\n  place-items: center;\n  border-radius: 50%;\n  opacity: 0;\n  transition: opacity 0.2s ease;\n}\n.field-flag.ok,\n.field-flag.taken,\n.field-flag.checking { opacity: 1; }\n.field-flag.ok { background: var(--mint); }\n.field-flag.ok::after {\n  content: \"\";\n  width: 9px;\n  height: 5px;\n  border-left: 2.4px solid #fff;\n  border-bottom: 2.4px solid #fff;\n  transform: rotate(-45deg) translate(1px, -1px);\n}\n.field-flag.taken { background: var(--bad); }\n.field-flag.taken::before,\n.field-flag.taken::after {\n  content: \"\";\n  position: absolute;\n  left: 50%;\n  top: 50%;\n  width: 10px;\n  height: 2.4px;\n  margin: -1.2px 0 0 -5px;\n  border-radius: 2px;\n  background: #fff;\n}\n.field-flag.taken::before { transform: rotate(45deg); }\n.field-flag.taken::after { transform: rotate(-45deg); }\n.field-flag.checking {